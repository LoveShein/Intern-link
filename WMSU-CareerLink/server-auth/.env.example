# ---- Server ----
PORT=5001
# Where the React app runs (Vite default). Comma-separate several origins if needed.
CLIENT_URL=http://localhost:5173

# ---- Security ----
# REQUIRED. At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# ---- PostgreSQL ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=careerlink
DB_USER=postgres
DB_PASSWORD=your_postgres_password
# Alternatively a single URL (hosted databases). Overrides the DB_* values above.
# DATABASE_URL=postgres://user:password@host:5432/dbname
# DB_SSL=true

# ---- First admin account (used by: npm run db:seed-admin) ----
ADMIN_NAME=WMSU Administrator
ADMIN_EMAIL=admin@wmsu.edu.ph
ADMIN_PASSWORD=choose-a-strong-password

# ---- Password reset emails (optional) ----
# Without SMTP the reset link is printed in the server console (development only).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@example.com
# SMTP_PASS=app-password
# MAIL_FROM="WMSU CareerLink <you@example.com>"

# ---- Deployment ----
# TRUST_PROXY=1   # set to the number of proxies in front of the app (Render, Heroku, Nginx...)
